{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "services/web"],
      "port": 5500
    },
    {
      "name": "api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-Command", "cd services/api; .venv\\Scripts\\python.exe -m uvicorn tbt_api.main:app --port 8001"],
      "port": 8001
    }
  ]
}
