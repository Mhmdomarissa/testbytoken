{
  "enabled": true,
  "browser": "chrome",
  "headless": false,
  "disable_secure_dns": true,
  "proxy_pac_url": "",
  "user_data_dir": "",
  "profile_directory": "Default",
  "implicit_wait_seconds": 5,
  "explicit_wait_seconds": 15,
  "page_load_timeout_seconds": 90,
  "script_timeout_seconds": 60,
  "page_load_strategy": "eager",
  "navigation_retries": 3,
  "block_images": false,
  "base_url": "demo",
  "demo_port": 8765,
  "screenshots_on_failure": true,
  "screenshot_dir": "logs/screenshots",
  "show_steps_in_browser": false,
  "show_execution_log_in_report": false,
  "step_display_delay_ms": 900,
  "locators": {
    "username": {"by": "id", "value": "username"},
    "password": {"by": "id", "value": "password"},
    "login_button": {"by": "id", "value": "btn-login"},
    "dashboard": {"by": "id", "value": "screen-dashboard"},
    "transfers_menu": {"by": "id", "value": "menu-transfers"},
    "transfer_self_link": {"by": "id", "value": "link-transfer-self"},
    "transfer_screen": {"by": "id", "value": "screen-transfer"},
    "page_title": {"by": "id", "value": "page-title"},
    "send_from": {"by": "id", "value": "send-from"},
    "send_to": {"by": "id", "value": "send-to"},
    "amount": {"by": "id", "value": "amount"},
    "transfer_date": {"by": "id", "value": "transfer-date"},
    "frequency": {"by": "id", "value": "frequency"},
    "message": {"by": "id", "value": "message"},
    "continue_button": {"by": "id", "value": "btn-continue"},
    "review_screen": {"by": "id", "value": "screen-review"},
    "confirm_button": {"by": "id", "value": "btn-confirm"},
    "success_message": {"by": "id", "value": "success-message"},
    "ref_line": {"by": "id", "value": "ref-line"},
    "logout_button": {"by": "id", "value": "btn-logout"}
  }
}
