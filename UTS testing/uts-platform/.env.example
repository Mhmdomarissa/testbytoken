# Zero-setup local database. The file is created automatically.
DATABASE_URL=sqlite:///web-data/uts_platform.db

# Change these before sharing/deployment.
UTS_SECRET_KEY=replace-with-a-long-random-secret
UTS_ADMIN_USERNAME=admin
UTS_ADMIN_PASSWORD=Admin@12345
UTS_SESSION_TIMEOUT_MINUTES=30
# Set true only when serving the platform over HTTPS.
UTS_SECURE_COOKIES=false

# Listen on every network interface so other LAN machines can connect.
UTS_HOST=0.0.0.0
UTS_PORT=5050
UTS_OPEN_BROWSER=true
UTS_BROWSER_URL=http://127.0.0.1:5050
UTS_NETWORK_IPS=192.168.0.107,192.168.1.24
UTS_PUBLIC_URL=http://192.168.1.24:5050

# AI brain (optional). Default planner is offline and needs no key.
# UTS_AI_PROVIDER=offline
# UTS_AI_PROVIDER=openai
# UTS_AI_PROVIDER=ollama
# UTS_AI_MODEL=gpt-4o-mini
# UTS_AI_BASE_URL=http://127.0.0.1:11434/v1
# UTS_AI_API_KEY=sk-...
