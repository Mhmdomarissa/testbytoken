# Auto worker settings for this PC (used by RUN-WORKER-AUTO.bat / INSTALL-AUTO-WORKER.bat)
# Copy to worker.env and edit values.

# Central UTS server
UTS_SERVER_URL=http://144.91.113.113:5050

# Same UTS username/password used on the web login
UTS_WORKER_USERNAME=admin
UTS_WORKER_PASSWORD=admin

# chrome | edge | firefox
UTS_WORKER_BROWSER=chrome
