.venv/
__pycache__/
*.pyc
shots/
.env
node_modules/

# Per-user engine workspaces — run artifacts, screenshots, reports, exports.
workspaces/

# The engine writes here when UTS_WORKDIR is unset (single-user fallback).
services/engine/generated/
services/engine/reports/
services/engine/logs/
services/engine/manual-tests/
services/engine/alm-output/
services/engine/xpedite-output/
services/engine/worker.env

# Vendor runtime log — not code, and it carried client module names.
services/engine/uts_engine/exporters/xpedite/generator_log.txt

# Vendored UTS platform: run artifacts, not source. These carried a client's
# module names, test cases and exports, and were stripped from history once.
reference/uts-platform/generated/
reference/uts-platform/alm-output/
reference/uts-platform/xpedite-output/
reference/uts-platform/reports/
reference/uts-platform/logs/

# Personal, per-machine Claude Code permissions — .claude/launch.json stays
# tracked (shared run config); this one is local-only.
.claude/settings.local.json

# Per-machine engine target + credential fallback. Prefer UTS_APP_USERNAME /
# UTS_APP_PASSWORD env vars instead of editing this file. Template lives at
# services/engine/config/app-input.example.json — copy it to get started.
services/engine/config/app-input.json

# Phase 0 before/after baseline artifacts — evidence, not source. make clean
# doesn't touch this (unlike services/engine/generated|reports|alm-output).
_baselines/
