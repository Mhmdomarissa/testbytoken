# Copy to .env and fill in what you need. Nothing here is required to start —
# see CLAUDE.md / docs/HANDOVER.md for what falls back to a safe default.

# --- services/api/tbt_api/config.py --------------------------------------

# LOCAL ONLY. 1 (default) lifts the free-tier target guardrail
# (is_allowed_target() in config.py) so you can test localhost, private IPs
# and local files from your own laptop. Set this to 0 before deploying
# anywhere another person can reach — see CLAUDE.md §5.
TAAS_LOCAL_DEMO=1

# Where the Playwright runner writes screenshots and the API serves them
# from, read-only, at /shots.
SHOTS_DIR=./shots

# --- services/api — the rest of the control plane ------------------------

# Powers the /plan LLM planner. Unset is fine — /plan falls back to a
# built-in keyword planner with no external call.
ANTHROPIC_API_KEY=

# Only if Playwright can't find Chromium on its own (normally unset —
# `playwright install chromium` handles this).
PLAYWRIGHT_CHROMIUM_PATH=

# Where per-user UTS engine workspaces are created. Defaults to workspaces/
# at the repo root.
TAAS_WORKSPACES_DIR=
# Idle seconds before an unused workspace is reaped.
TAAS_WORKSPACE_IDLE_SECONDS=1800

# --- services/engine/uts_engine -------------------------------------------

# Where a run's own generated/, reports/, logs/ etc. are written. Unset
# falls back to services/engine/ itself (single-user, one checkout).
# uts_workspace.py sets this per session when it spawns the engine.
UTS_WORKDIR=

# Seconds the customer gets to complete an interactive login before the
# handoff times out.
UTS_LOGIN_TIMEOUT=600

# Path to a chromedriver binary, if you don't want webdriver-manager to
# resolve one automatically.
UTS_CHROMEDRIVER=

# offline (default) = the built-in rule-based planner, no external AI call.
# Set to e.g. openai to route dynamic/ai_brain.py through a real LLM instead.
UTS_AI_PROVIDER=offline
UTS_AI_MODEL=
UTS_AI_BASE_URL=
OPENAI_API_KEY=

# --- services/engine/uts_engine/worker — the poll-based worker agent -----
# (kept per docs/UTS_INTEGRATION_PLAN.md F7 for a future "run on the
# customer's own machine" mode; not used by the per-user engine host path.)

UTS_SERVER_URL=http://127.0.0.1:5050
UTS_WORKER_USERNAME=
UTS_WORKER_PASSWORD=
UTS_ADMIN_USERNAME=
UTS_ADMIN_PASSWORD=
UTS_WORKER_BROWSER=chrome
